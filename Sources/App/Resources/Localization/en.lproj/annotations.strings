/* Marks drawn on screenshots and in the live overlay (Annotations/). */

/* Tool names. */
"annotations.tool.select" = "Select";
"annotations.tool.arrow" = "Arrow";
"annotations.tool.callout" = "Arrow with text";
"annotations.tool.rectangle" = "Rectangle";
"annotations.tool.ellipse" = "Ellipse";
"annotations.tool.line" = "Line";
"annotations.tool.highlighter" = "Highlighter";
