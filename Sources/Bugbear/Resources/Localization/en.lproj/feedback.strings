/* "Report a problem" and "Suggest a feature" (Feedback/). %@ is the app's name unless noted. */

/* The two kinds of feedback. */
"feedback.kind.problem" = "Report a problem";
"feedback.kind.feature" = "Suggest a feature";
"feedback.kind.tip" = "Problems and ideas go to the %@ repository on GitHub as issues";

/* The form. */
"feedback.field.title" = "Title";
"feedback.field.title.placeholder.problem" = "For example: The saved clip is black";
"feedback.field.title.placeholder.feature" = "For example: Blur faces automatically";
"feedback.field.details" = "Details";
"feedback.field.details.problem" = "What happened? What did you expect?";
"feedback.field.details.feature" = "What would you like %@ to do?";

/* Logs. zipNote: the app's name, then the folder the zip is saved to. zipFailed: the folder. */
"feedback.logs.attach" = "Attach logs";
"feedback.logs.attach.tip" = "Add the last lines of %@'s log to the issue and save the full logs as a zip to drag into it";
"feedback.logs.zipNote" = "A zip with %1$@'s full log and crash reports is saved to %2$@ and shown in Finder. Drag it into the issue on GitHub.";
"feedback.logs.zipFailed" = "The logs zip could not be saved to %@, so the issue opened without it.";

/* What will be sent. titleLine: the title typed. log: how many log lines. */
"feedback.preview.title" = "What will be sent";
"feedback.preview.tip" = "Your home folder and user name are replaced with ~ and <user>";
"feedback.preview.titleLine" = "Title: %@";
"feedback.preview.zip" = "Zip: environment.txt, the full bugbear.log and %@'s crash reports from the last 14 days.";

/* Buttons and notes. */
"feedback.footer.nothingSent" = "Nothing is sent until you press Submit on GitHub.";
"feedback.button.cancel" = "Cancel";
"feedback.button.open" = "Open on GitHub";
"feedback.button.open.tip" = "Open the filled issue form in your browser to check it and submit";
"feedback.error.linkTooLong" = "Could not build the GitHub link. Try a shorter description.";
"feedback.notice.error" = "%@ ran into an error. A report helps fix it. Add what you were doing when it happened.";
"feedback.notice.crash" = "%@ quit unexpectedly last time. Sending a report with the crash details helps fix it. Add what you were doing, if you remember.";
