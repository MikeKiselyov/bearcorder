# Copy to .env and adjust. .env is git-ignored; never commit it.

# Bundle identifier of your build. Use your own reverse-DNS name; a build with any other
# identifier than the default is called "Bugbear Dev", so it is not mixed up with an installed Bugbear.
BUGBEAR_BUNDLE_ID=io.github.bugbear.app

# Code signing identity. A stable identity (e.g. a free "Apple Development" certificate
# from Xcode) lets macOS remember Screen Recording, Camera and Microphone permissions
# between rebuilds. List yours with: security find-identity -v -p codesigning
# Leave empty to auto-pick the first "Apple Development" identity, or without one a
# certificate made for this Mac (scripts/local-signing.sh). "local" always uses that one,
# "-" signs ad-hoc.
BUGBEAR_SIGN_IDENTITY=
